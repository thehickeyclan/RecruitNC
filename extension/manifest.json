{
  "manifest_version": 3,
  "name": "RecruitWrestlers Interest Form Helper",
  "version": "0.2.0",
  "description": "Fills college wrestling interest forms with your RecruitWrestlers answers. You check each one and press Submit.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.recruitwrestlers.com/*",
    "https://app.ncwrestlingunited.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RecruitWrestlers interest forms",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.armssoftware.com/*",
        "https://*.frontrush.com/*",
        "https://*.jumpforward.com/*",
        "https://*.arirecruiting.com/*",
        "https://app.spry.so/*",
        "https://*/sb_output.aspx*",
        "https://*/form/*",
        "https://www.recruitwrestlers.com/my-recruiting/*",
        "https://app.ncwrestlingunited.com/my-recruiting/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/page.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
